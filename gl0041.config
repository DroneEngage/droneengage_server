{
    // GL-0041 e2e test instance — local drone server, no auth, no storage.
    // Run: node src/server.js --config=gl0041.config
    "server_id"                     : "DE_CommSrv_GL0041",
    "server_ip"                     : "::",
    "public_host"                   : "127.0.0.1",
    "server_port"                   : 9967,
    "s2s_ws_target_ip"              : "127.0.0.1",
    "s2s_ws_target_port"            : "19001",
    "ssl_key_file"                  : "./ssl_local/ssl_airgap/domain.key",
    "ssl_cert_file"                 : "./ssl_local/ssl_airgap/domain.crt",
    "allow_fake_SSL"                : true,
    "ca_cert_path"                  : "./ssl_local/ssl_airgap/root.crt",
    "ignoreLoadingTasks"            : true,

    // Local-server mode: accept modules/clients without external auth.
    "local_server_enabled"          : true,
    "ignore_auth_server"            : true,
    "local_server_account_id"       : "1",

    "s2s_my_private_key"            : "./ssl_local/DE_ServerComm_private.pem",
    "s2s_shared_secret_file"        : "./s2s_shared_secret.key",
    "enable_storage_server"         : false,

    "ignoreLog"                 : false,
    "log_directory"             : "./logs/",
    "log_timeZone"              : "GMT",
    "log_detailed"              : true,
    "debug_logging"             : true,

    "ws_compression"            : false,
    "ws_auth_no_frame_old_compatibility" : true,
    "memory_max"                : 973,

    "outbound_guard"            : {
        "enabled"               : true,
        "high_water_bytes"      : 262144,
        "hard_cap_bytes"        : 4194304,
        "latest_wins_message_types" : [
            1002, 1003, 1036, 1043, 1053, 1059, 1083, 2022,
            6001, 6502, 6503, 6506, 6507, 6508, 6510, 6516,
            6520, 6529, 6535, 1092
        ]
    }
}
