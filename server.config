{
    "server_id"                     : "DE_CommSrv",
    "server_ip"                     : "::",
    "public_host"                   : "airgap.local",
    "server_port"                   : 9966,
    "s2s_ws_target_ip"              : "127.0.0.1",
    "s2s_ws_target_port"            : "19001",
    "ssl_key_file"                  : "./ssl_local/ssl_airgap/domain.key",
    "ssl_cert_file"                 : "./ssl_local/ssl_airgap/domain.crt",
    "allow_fake_SSL"                : true,
    "ca_cert_path"                  : "./ssl_local/ssl_airgap/root.crt",
    "ignoreLoadingTasks"            : true,
    "allow_udpproxy_fixed_port"     : true,
    // Command plugins — paths are resolved relative to the server root.
    // The AIS stream plugin connects to aisstream.io and forwards AIS data
    // to subscribed GCS clients. Requires aisstream.api_key below.
    "command_plugin"             : ["../droneengage_server_plugins/aisstream/index.js"],
    // AIS stream provider configuration (used by the aisstream plugin).
    // Get your API key at https://aisstream.io/account
    "aisstream"                  : {
        "api_key"                : "",
        "url"                    : "wss://stream.aisstream.io/v0/stream"
    },
    // Server-to-Server (S2S) authentication. Ed25519 key pair generated by gen_s2s_keys.js
    // Comm server CONNECTS to Auth (needs private key).
    // s2s_auth_enabled is managed by the authenticator only; comm server always attempts S2S auth.
    "s2s_my_private_key"            : "./ssl_local/DE_ServerComm_private.pem",
    // Storage server endpoint for direct connection
    "enable_storage_server"         : true,
    "storage_server_host"           : "127.0.0.1",
    "storage_server_port"           : 9000,
    // logging
    "ignoreLog"                 : true,
    "log_directory"             : "./logs/",
    "log_timeZone"              : "GMT",
    "log_detailed"              : false,

    // Verbose console debug logging (checkMemory readings, debug ... lines).
    // Default false in production to avoid log spam. Override via server.config.local
    // or the de_comm_debug_logging env var ("true"/"1" to enable).
    "debug_logging"             : false,

    "ws_compression"            : false,
    // Security item 2.1: frame-based WS auth (de_auth frame) is always
    // enabled. This flag controls backward compatibility with legacy clients
    // that send credentials in the URL query string.
    //   true  (default) -> accept query-string creds alongside the frame path
    //   false           -> only the de_auth frame path is allowed
    // See js_chat_connection.js for the protocol.
    "ws_auth_no_frame_old_compatibility" : false,
    //server reboot - reboot server when process memory exceeds a certain limit.
    "memory_max"                : 973,      // in MB

    // Outbound backpressure guard (see js_outbound_guard.js).
    // Stops one slow client from making the server queue unlimited data.
    // Per target socket, before each send the guard checks bufferedAmount:
    //   below high_water_bytes        -> send everything
    //   high_water .. hard_cap_bytes  -> send must_deliver only, skip latest_wins
    //   above hard_cap_bytes          -> terminate socket (client reconnects)
    // latest_wins_message_types = numeric mt values where a stale message is
    // worthless because a fresher one follows soon (telemetry/status types).
    // Unknown mt values are always must_deliver. Set enabled=false to
    // restore the old fire-and-forget behaviour.
    "outbound_guard"            : {
        "enabled"               : true,
        "high_water_bytes"      : 262144,
        "hard_cap_bytes"        : 4194304,
        "latest_wins_message_types" : [
            1002,   // TYPE_AndruavMessage_GPS
            1003,   // TYPE_AndruavMessage_POWER
            1036,   // TYPE_AndruavMessage_NAV_INFO (legacy telemetry)
            1043,   // TYPE_AndruavMessage_TrackingTargetLocation
            1053,   // TYPE_AndruavMessage_SensorsStatus
            1059,   // TYPE_AndruavMessage_CommSignalsStatus
            1078,   // TYPE_AndruavMessage_AI_Recognition_TargetLocation
            1083,   // TYPE_AndruavMessage_Viewlink_Telemetry
            2022,   // TYPE_AndruavMessage_LightTelemetry
            6001,   // TYPE_AndruavMessage_ServoChannel
            6502,   // TYPE_AndruavMessage_MAVLINK (raw mavlink telemetry)
            6503,   // TYPE_AndruavMessage_SWARM_MAVLINK
            6506,   // TYPE_AndruavMessage_P2P_STATUS
            6507,   // TYPE_AndruavMessage_P2P_InRange_BSSID
            6508,   // TYPE_AndruavMessage_P2P_InRange_Node
            6510,   // TYPE_AndruavMessage_Communication_Line_Status
            6516,   // TYPE_AndruavMessage_SDR_SPECTRUM
            6520,   // TYPE_AndruavMessage_GPIO_STATUS
            6529,   // TYPE_AndruavMessage_IR_CAMERA_MI48_STATUS
            6535    // TYPE_AndruavMessage_MODULE_HEALTH_STATUS
        ]
    }

}
